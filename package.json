{
  "name": "gout",
  "version": "1.0.0",
  "description": "G.O.U.T. \u2014 Gewoon Op Uw Tempo. Lichte routeplanner & GPX-editor voor wandelen, fietsen en mountainbike.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/check-node.js && node scripts/dev.js",
    "dev:mock": "node scripts/check-node.js && node scripts/dev.js --mock",
    "build": "vite build web",
    "start": "node scripts/check-node.js && node server/index.js",
    "seed": "node scripts/seed.js",
    "typecheck": "tsc --noEmit -p web",
    "test": "node --no-warnings --test server/test/api.test.js",
    "test:e2e": "node e2e/smoke.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "leaflet": "^1.9.4",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=22"
  }
}
